{
  "name": "reference_transunet_s8012",
  "seed": 8012,
  "model": {
    "transformer_hidden": 768,
    "transformer_layers": 12,
    "transformer_heads": 12,
    "resnet_units": [
      3,
      4,
      9
    ],
    "transformer_mlp_ratio": 4,
    "transformer_dropout": 0.1,
